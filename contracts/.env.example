# Robinhood Chain mainnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Тестнет, chain id 46630
TESTNET_RPC_URL=
# Ключ деплоера. В мейннете владельцем ставим мультиподпись, не этот адрес.
PRIVATE_KEY=
# Форк-тест. Фид — из reference-data-directory, здесь Robinhood NVDA / USD.
# FORK_TOKEN необязателен: без него тест разворачивает свой ERC-20 с теми же
# восемнадцатью знаками, а USDG и фид остаются настоящими.
FORK_FEED=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
FORK_TOKEN=0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec

# Деплой
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
TOKEN_ADDRESS=0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
FEED_ADDRESS=
OWNER_ADDRESS=0xef048611d7F3077b35Fab260565886186fDa32bA
GUARDIAN_ADDRESS=0xef048611d7F3077b35Fab260565886186fDa32bA
# Календарь: вывод node script/expiries.mjs 26, без скобок
EXPIRIES=
# Бот расчёта: адрес фабрики после деплоя. Ключ ему нужен только на газ.
FACTORY_ADDRESS=
# Лимиты первого запуска: премия не выше 10%, цена не старше 80 часов (выходные),
# расчёт по цене не старше 6 часов, от 100 USDG, до 5 000 на позицию,
# до 50 000 замороженного на неделю, до 60% инвентаря в работе.
MAX_PREMIUM_BPS=1000
MAX_PRICE_AGE=288000
MAX_PRICE_AGE_SETTLE=21600
MIN_DEPOSIT_VALUE_WAD=100000000000000000000
MAX_POSITION_VALUE_WAD=5000000000000000000000
MAX_EXPIRY_LOCK_VALUE_WAD=50000000000000000000000
MAX_LOCKED_SHARE_BPS=6000
