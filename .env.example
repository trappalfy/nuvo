# The live address of the site, e.g. https://nuvo.finance. Used for the link
# preview image and the app icon mobile wallets show when they connect.
NEXT_PUBLIC_SITE_URL=

# Robinhood Chain mainnet. The app reads and writes on this network only.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Contracts.
NEXT_PUBLIC_NUVO_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_USDG_SYMBOL=USDG

# Tokenized stocks, comma separated: SYMBOL:tokenAddress:chainlinkFeedAddress
# e.g. NVDA:0x...:0x...,TSLA:0x...:0x...
NEXT_PUBLIC_STOCK_TOKENS=

# Market maker quote service. GET /premiums?week=&direction= and POST /quote,
# see README.
NEXT_PUBLIC_QUOTE_API=

# Limits per product. Empty or 0 means no limit.
NEXT_PUBLIC_MIN_USDG=
NEXT_PUBLIC_MAX_USDG=
NEXT_PUBLIC_MIN_STOCK_VALUE_USDG=

# The Nuvo token, shown on /token. Leave the address empty until launch.
# TOKEN_URL is where "View contract" goes; without it, the address on
# EXPLORER_URL. TOKEN_NETWORK defaults to CHAIN_NAME.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_SYMBOL=
NEXT_PUBLIC_TOKEN_NETWORK=
NEXT_PUBLIC_TOKEN_URL=

# Footer links. Only https links are shown; an empty one is left out.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# WalletConnect project id. Enables mobile wallets through QR; browser wallets
# work without it.
NEXT_PUBLIC_WALLETCONNECT_ID=
