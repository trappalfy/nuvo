# Brief 9: data layer mode. mock = demo data in the UI, chain = on-chain reads (not wired yet).
NEXT_PUBLIC_NUVO_MODE=mock

# Brief: default network is Robinhood Chain mainnet. No testnet faucets, no testnet banners.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Settlement currency and the dual-investment contract.
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_NUVO_ADDRESS=

# Tokenized stock addresses, comma separated as TICKER:0x...
NEXT_PUBLIC_STOCK_TOKENS=

# WalletConnect project id for RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_ID=
